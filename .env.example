# Copy this file to ".env" (same folder) and fill in your key(s).
# Never share .env or paste keys into chat/email.

# ---------------------------------------------------------------------
# LLM_PROVIDER picks who handles the ranking/suggestion calls (used by
# suggest_reviewers.py, and enrich_reviewers.py's summarizing step).
# Default 'ollama' -- your locally-signed-in Ollama desktop app, no key
# needed, nothing below required. To bring your own key for a different
# provider instead, set BOTH of these:
#
#   LLM_PROVIDER=anthropic       # or: openai, groq, openrouter, ollama_cloud
#   LLM_API_KEY=sk-...           # YOUR OWN key for that provider
#
# Each person running this script (you, a co-chair, next year's
# co-chairs) can use their own key here -- nothing shared.
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_API_KEY=
# LLM_MODEL=                     # optional: override the provider's default model

# ---------------------------------------------------------------------
# enrich_reviewers.py's web-*search* step is separate from the above --
# it's what actually finds a reviewer's position/interests/website.
#   - LLM_PROVIDER=ollama/ollama_cloud: needs OLLAMA_API_KEY below
#     regardless of the ranking provider (Ollama Cloud's is the only
#     standalone "raw search results" endpoint wired up here).
#   - LLM_PROVIDER=anthropic/openai: uses that provider's own built-in
#     web-search tool instead, authenticated with LLM_API_KEY above --
#     OLLAMA_API_KEY isn't needed for enrichment in that case.
# Get an Ollama key at https://ollama.com/settings/keys.
# ---------------------------------------------------------------------
OLLAMA_API_KEY=

# Optional overrides (defaults shown) for the 'ollama' local-app path.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Optional: only needed if you keep more than one .xlsx next to
# reviewer_tools/ (with exactly one, it's found automatically).
# WORKBOOK_PATH=C:\path\to\your_conference_reviewers.xlsx

# ---------------------------------------------------------------------
# Optional: set GOOGLE_SHEET_ID to use a shared Google Sheet instead of
# the local .xlsx (all three scripts then ignore WORKBOOK_PATH/--workbook
# entirely). See README.md's "Google Sheets backend" section for setup.
# ---------------------------------------------------------------------
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json   # local: path to the key file
# GOOGLE_SERVICE_ACCOUNT_JSON=                        # OR: the key's raw JSON (GitHub Actions secrets)

# Optional: sharpens the model's name-collision check and its sense of
# "topical fit" for your conference. Generic defaults work without these.
# CONFERENCE_NAME=MyConf 2027
# CONFERENCE_FIELD=human-computer interaction
