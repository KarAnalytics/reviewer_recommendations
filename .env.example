# Copy this file to ".env" (same folder) and fill in your key.
# Never share .env or paste the key into chat/email.

# Required by enrich_reviewers.py (web lookups).
# Get a key at https://ollama.com/settings/keys (sign in with the same
# account this machine's Ollama app is already signed in with).
OLLAMA_API_KEY=

# Optional overrides (defaults shown). suggest_reviewers.py talks to your
# local Ollama app, which is already signed in, so it does NOT need
# OLLAMA_API_KEY -- only the web-search step in enrich_reviewers.py does.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
